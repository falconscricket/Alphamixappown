{
  "manifest_version": 3,
  "name": "Alpha",
  "version": "30.0",
  "version_name": "V30",
  "description": "ALPHA Mic Booster V30",
  "browser_specific_settings": {
    "gecko": {
      "id": "alpha@alpha.local"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://alphamicbackend-production-d20a.up.railway.app/*"
  ],
  "background": {
    "scripts": [
      "license-config.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "engine_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "AUDIO/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}